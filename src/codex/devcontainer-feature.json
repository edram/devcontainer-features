{
    "id": "codex",
    "version": "1.0.2",
    "name": "Codex",
    "documentationURL": "https://github.com/edram/devcontainer-features/tree/main/src/codex",
    "description": "Installs the Codex CLI, OpenAI's coding agent, globally on the PATH.",
    "containerEnv": {
        "CODEX_INSTALL_DIR": "/usr/local/bin",
        "CODEX_HOME": "/usr/local/share/codex"
    },
    "options": {
        "version": {
            "type": "string",
            "default": "latest",
            "proposals": [
                "latest"
            ],
            "description": "Select the Codex CLI version to install. Use 'latest' or a specific version like '0.1.0'."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
